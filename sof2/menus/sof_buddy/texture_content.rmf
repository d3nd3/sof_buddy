<stm>
<include sof_buddy/tints>
<key escape "menu sof_buddy main">
<cursor 1>

<vbar tint sb_accent>

<defaults noborder tiptint normaltext tipbtint sb_panel tipfont title>
<backdrop bgcolor sb_bg>

<left> 32
<right> 32
<normal>

<include sof_buddy/tabs/texture>

<center>
<font type title tint sb_accent atint sb_accent>
"_____________________________"
<hbr>
<hbr>
<font type title tint white atint white>
<text "SOF2 BUDDY: GRAPHICS">
<center>
<font type title tint cyan atint cyan>
"_____________________________"
<hbr>
<hbr>
<font type title tint cyan atint cyan>
"Video"
<font type title tint white atint white>
<includecvar _sof2bud_mode_list_rmf>
<list "Windowed,Fullscreen" match "0,1" cvar r_fullscreen atext "Fullscreen : " noshade tip "r_fullscreen"><br>
<hbr>
<text "Refresh mode list" key mouse1 "sof2buddy_refresh_modes" border 8 1 cyan regular align center tip "Rebuild resolution list after display or sof2bud modelist changes."><hbr>
<hbr>
<text "Vid Restart" key mouse1 "vid_restart" border 8 1 cyan regular align center>
<text "Close" key mouse1 "popmenu" border 8 1 cyan regular align center>
</stm>
