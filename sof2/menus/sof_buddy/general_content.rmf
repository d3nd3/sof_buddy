<stm>
<include sof_buddy/tints>
<key escape "menu sof_buddy main">
<cursor 1>

<vbar tint sb_accent>

<defaults noborder tiptint normaltext tipbtint sb_panel tipfont title>
<backdrop bgcolor sb_bg>

<left> 32
<right> 32
<normal>

<include sof_buddy/tabs/general>

<center>
<font type title tint sb_accent atint sb_accent>
"_____________________________"
<hbr>
<hbr>
<font type title tint white atint white>
<text "SOF2 BUDDY: GENERAL" align center border 0 0>
<center>
<font type title tint cyan atint cyan>
"_____________________________"
<hbr>
<hbr>
<font type title tint white atint white>
<text "Menu key" align center border 0 0><hbr>
<text "F12 opens SoF2 Buddy (same as SoF Buddy on SoF1)." noshade tip "Bound at startup: sof2buddy_menu sof_buddy/main"><hbr>
<hbr>
<text "Re-bind F12" key mouse1 "sof2buddy_apply_f12" border 8 1 cyan regular align center><hbr>
<hbr>
<text "Open Version tab" key mouse1 "menu sof_buddy main" border 8 1 cyan regular align center><hbr>
<text "Open Graphics tab" key mouse1 "menu sof_buddy texture" border 8 1 cyan regular align center><hbr>
<hbr>
<ctext rate atext "rate : " noshade tip "sof2bud sets rate 20000 at startup (required for stable MP)."><hbr>
<text "Restore rate 20000" key mouse1 "set rate 20000" border 8 1 cyan regular align center><hbr>
<hbr>
<text "Close" key mouse1 "popmenu" border 8 1 cyan regular align center><hbr>
</stm>
