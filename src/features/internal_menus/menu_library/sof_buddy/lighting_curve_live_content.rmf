<stm>
<include tints>
{theme_tints}
<key escape "sofbuddy_close_menu">
<cursor 1>

<vbar tint sb_accent>

<defaults noborder tiptint normaltext tipbtint sb_panel tipfont {tipfont}>
<backdrop bgcolor sb_bg>

<left>
<blank 6 1>
<right>
<blank 6 1>
<normal>

<center>
<hbr>
<font type {font_title} tint sb_accent atint sb_accent>
"TONE CURVE"
<hbr>
<hbr>
<font type {font_small} tint white atint white>
<hbr>
<ctext _sofbuddy_lighting_curve_0 atext "Input 0% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_0 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_10 atext "Input 10% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_10 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_20 atext "Input 20% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_20 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_30 atext "Input 30% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_30 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_40 atext "Input 40% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_40 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_50 atext "Input 50% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_50 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_60 atext "Input 60% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_60 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_70 atext "Input 70% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_70 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_80 atext "Input 80% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_80 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_90 atext "Input 90% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_90 min 0 max 100 step 1><hbr>
<hbr>
<ctext _sofbuddy_lighting_curve_100 atext "Input 100% : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_lighting_curve_100 min 0 max 100 step 1><hbr>
<text "Reset Curve" tip "Reset the 11-point curve to linear 0,10,...,100." key mouse1 "sofbuddy_lighting_curve_reset;refresh" border 8 1 cyan regular align center><hbr>
<text "Back to Lighting" tip "Return to the Lighting tab." key mouse1 "sofbuddy_close_menu;sofbuddy_menu sof_buddy/lighting" border 8 1 orange regular align center><hbr>
<text "Back to Game" tip "Close the live panel and return to the game." key mouse1 "sofbuddy_close_menu" border 8 1 orange regular align center>
</stm>
