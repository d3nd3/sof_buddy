<stm>
<ctext _sofbuddy_font_scale atext "Font Scale : " tint sb_accent atint sb_accent noshade tip "Integer scale: 1x, 2x, 3x, up to the vertical max."><br>
<slider cvari _sofbuddy_font_scale min 1 max {scale_int_max} step 1><br>
<font type {font_title} tint sb_accent atint sb_accent>
<ctext _sb_internal_font_scale_rounded atext "Current font scale : " noshade><br>
<font type {font_title} tint white atint white>
<text "Reset to default" key mouse1 "sofbuddy_scale_reset font" border 8 1 cyan regular align center><br>
</stm>
