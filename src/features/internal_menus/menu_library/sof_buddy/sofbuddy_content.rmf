<stm>
<strings key>
<include tints>
{theme_tints}
<key escape "sofbuddy_menu sof_buddy">
<cursor 1>

<vbar tint sb_accent>

<defaults noborder tiptint normaltext tipbtint sb_panel tipfont {tipfont}>
<backdrop bgcolor sb_bg>

<left>
{content_inset_tall}
<right>
{content_inset_tall}
<normal>


<center>
<font type {font_title} tint sb_accent atint sb_accent>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<text "SOF BUDDY: GENERAL">
<center>
<font type {font_title} tint cyan atint cyan>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
<text "Loading Screen">
<hbr>
<font type {font_title} tint white atint white>
<list "Unlocked,Locked" match "0,1" cvar _sofbuddy_loading_lock_input atext "Lock loading input : " noshade tip "Controls whether the console can be opened while loading: Unlocked allows it; Locked blocks it."><br>
<list "Off,On" match "0,1" cvar _sofbuddy_loading_show_mapname atext "Show map name : " noshade tip "Show the current map name on the loading screen header."><br>
<list "Off,On" match "0,1" cvar _sofbuddy_loading_show_download atext "Show download status : " noshade tip "Show HTTP/download status text on the loading screen header."><br>
<text "Preview Loading Screen" key mouse1 "sofbuddy_menu loading" border 8 1 cyan regular align center>
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
<text "Menu">
<hbr>
<font type {font_title} tint white atint white>
{menu_theme_list}
<ctext tip_duration atext "Menu tooltip Duration (ms) : " tint sb_accent atint sb_accent noshade><br>
<slider cvari tip_duration min 0 max 30000 step 250 tip "How long menu tooltips stay visible (ms). SoF Buddy default 15000."><hbr>
<ctext _sofbuddy_menu_tip_appear atext "Menu tooltip Appear (ms) : " tint sb_accent atint sb_accent noshade><br>
<slider cvari _sofbuddy_menu_tip_appear min 0 max 2500 step 50 tip "Delay before a tooltip appears. 0 = immediate. Default 750.">
<hbr>
<list "Small,Medium,Title" match "0,1,2" cvari _sofbuddy_menu_tip_font atext "Tooltip font : " tip "Font used for F12 tooltips. Reopen the menu after changing."><hbr>
<list "Small,Normal,Large,Extra Large" match "0,1,2,3" cvari _sofbuddy_menu_font_size_style key mouse1 "sofbuddy_menu sof_buddy/sofbuddy" key mouse2 "sofbuddy_menu sof_buddy/sofbuddy" atext "Menu font size style : " tip "Font tier template: Small drops each font one tier, Normal keeps authored, Large raises smaller fonts, Extra Large uses title throughout. Reopens the page to apply."><hbr>
<list "Off,On" cvari _sofbuddy_snd_quiet_alt_tab atext "Quiet Alt-Tab sound messages : " noshade tip "Hides DirectSound buffer creation/release messages, including those printed when Alt-Tab reactivates audio."><hbr>
<text "Bonus menu key (F12 always works)" noshade>
<hbr>
<setkey "sofbuddy_menu sof_buddy" atext "Additional key : " tip "Click this row, then press the extra key you want to open SoF Buddy. F12 remains the default menu key."><hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
<text "Startup">
<hbr>
<font type {font_title} tint white atint white>
<list "Off,On" match "0,1" cvar _sofbuddy_update_check_startup atext "Check updates on startup : " noshade tip "Runs release check when SoF starts."><br>
<list "Off,On" match "0,1" cvar _sofbuddy_update_startup_stable_only atext "Startup notify stable only : " noshade tip "On: auto update prompt only for stable releases from master. Off: uses Install version on F12. Default Off."><br>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<text "Restore SoF Buddy Defaults" key mouse1 "set _sofbuddy_menu_theme 21;set tip_duration 15000;set _sofbuddy_menu_tip_appear 750;set _sofbuddy_menu_tip_font 0;set _sofbuddy_menu_font_size_style 0;set _sofbuddy_snd_quiet_alt_tab 1;set _sofbuddy_menu_hotkey F12;sofbuddy_apply_menu_hotkey;set _sofbuddy_loading_lock_input 0;set _sofbuddy_loading_show_mapname 1;set _sofbuddy_loading_show_download 1;reloadall;sofbuddy_menu sof_buddy/sofbuddy" border 8 1 cyan regular align center>
<hbr>
<text "Close" key mouse1 "popmenu" border 8 1 cyan regular align center>
</stm>
