<stm>
<include tints>

<backdrop bgcolor black>
<key escape "killmenu">
<key n "killmenu">

<vbar tint orange>

<left>
<blank 16 1>
<right>
<blank 16 1>
<normal>

<center>
<font type title tint orange atint orange>
"SOF BUDDY IS UP TO DATE"
<hbr>
<hbr>

<font type title tint white atint white>
<ctext _sb_internal_update_local_label atext "Installed : " noshade><hbr>
<ctext _sb_internal_update_latest atext "Checked release : " noshade><hbr>
<ctext _sb_internal_update_status atext "Status : " noshade><hbr>
<hbr>

<font type title tint gray atint gray>
"No newer release is available for your install target."
<hbr>
<hbr>

<center>
<font type title tint white atint white>
<text "OK (N)" border 16 1 gray key mouse1 "killmenu">
</stm>
