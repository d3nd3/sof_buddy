<stm>
<include tints>
{theme_tints}
<key escape "sofbuddy_menu sof_buddy">
<cursor 1>

<vbar tint sb_accent>

<defaults noborder tiptint normaltext tipbtint sb_panel tipfont {tipfont}>
<backdrop bgcolor sb_bg>

<left>
{content_inset_tall}
<right>
{content_inset_tall}
<normal>


<center>
<font type {font_title} tint sb_accent atint sb_accent>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<text "SOF BUDDY: RAW CVARS">
<center>
<font type {font_title} tint cyan atint cyan>
"_____________________________"
<hbr>
<hbr>
<center>
<font type {font_title} tint cyan atint cyan>
"Performance / Timers"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_high_priority atext "_sofbuddy_high_priority : " noshade tip "Process priority. 1 High, 0 Normal. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - High process priority. 0 is Normal."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_sleep atext "_sofbuddy_sleep : " noshade tip "CPU sleep between frames. 1 on saves CPU, 0 off. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - CPU-saving sleep between frames."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_sleep_jitter atext "_sofbuddy_sleep_jitter : " noshade tip "Experimental frame borrowing. Leave 0 unless needed. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Experimental jitter, leave off."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_sleep_busyticks atext "_sofbuddy_sleep_busyticks : " noshade tip "Busyloop 1ms ticks per frame. Lower saves CPU, 0 may stutter. Default 2."><br>
<font type {font_title} tint gray atint gray>
"Default 2 - Busyloop ticks. Lower saves CPU."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_cl_maxfps_exact atext "_sofbuddy_cl_maxfps_exact : " noshade tip "1 = cl_maxfps is literal FPS. 0 = legacy ms-budget list. F12 CPU. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Legacy framerate cap encoding."
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
"UI Scale"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_font_scale atext "_sofbuddy_font_scale : " noshade tip "Manual font multiplier 0.25 to 8. Values above the resolution max use the max scale. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Manual font scale."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<font type {font_title} tint gray atint gray>
"Default 1 - Axis used for the font max scale."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_font_pack atext "_sofbuddy_font_pack : " noshade tip "Font pack: 0 Default, 1 Force SoFPlus, 2 Force Vanilla. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Default font pack."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_console_size atext "_sofbuddy_console_size : " noshade tip "Console height as screen fraction 0 to 1. Default 0.5."><br>
<font type {font_title} tint gray atint gray>
"Default 0.5 - Console height fraction of screen."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_hud_scale atext "_sofbuddy_hud_scale : " noshade tip "Manual HUD multiplier 0.25 to 8. Values above the resolution max use the max scale. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Manual HUD scale."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<font type {font_title} tint gray atint gray>
"Default 1 - Axis used for the HUD max scale."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_menu_scale atext "_sofbuddy_menu_scale : " noshade tip "Actual-pixel menu scale (blanks, borders, images, text). Values above the resolution max use the max scale (vid_h / 480). 1 = vanilla SoF. 0.25 to 8. Scaled Menu feature."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Manual menu scale."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_crossh_scale atext "_sofbuddy_crossh_scale : " noshade tip "Crosshair size multiplier. F12 Gameplay. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Crosshair size multiplier."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_crossh_scale_auto atext "_sofbuddy_crossh_scale_auto : " noshade tip "Track crosshair scale from the selected resolution axis. 1 on, 0 off. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Manual crosshair scale."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<font type {font_title} tint gray atint gray>
"Default 1 - Vertical crosshair auto-scale axis."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_crosshair_theme atext "_sofbuddy_crosshair_theme : " noshade tip "Crosshair theme index used by the crosshair picker. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Default crosshair theme."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_scale_cinematic_pics atext "_sofbuddy_scale_cinematic_pics : " noshade tip "Scale credit and fade pics up from 640x480. 1 on. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Scale cinematic credit images."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_scale_round_auto atext "_sofbuddy_scale_round_auto : " noshade tip "Snap effective menu and cinematic image scale to round steps. 1 on, 0 off. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Round effective menu and cinematic scale."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_scale_round_ratio atext "_sofbuddy_scale_round_ratio : " noshade tip "Snap step for Auto and manual font, HUD, and menu scales; cinematics when rounding is on. Default 0.25."><br>
<font type {font_title} tint gray atint gray>
"Default 0.25 - Round step for scale presets and cinematics."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_icons_autoscale atext "_sofbuddy_icons_autoscale : " noshade tip "Scale team icons and playernames above players with HUD scale. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Icons autoscale on."
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
"Texture Filtering"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_minfilter_unmipped atext "_sofbuddy_minfilter_unmipped : " noshade tip "Sky and detail min filter. GL_NEAREST or GL_LINEAR. Default GL_LINEAR."><br>
<font type {font_title} tint gray atint gray>
"Default GL_LINEAR - Unmipped min filter."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_magfilter_unmipped atext "_sofbuddy_magfilter_unmipped : " noshade tip "Sky and detail mag filter. GL_NEAREST or GL_LINEAR. Default GL_LINEAR."><br>
<font type {font_title} tint gray atint gray>
"Default GL_LINEAR - Unmipped mag filter."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_minfilter_mipped atext "_sofbuddy_minfilter_mipped : " noshade tip "World min filter with mipmaps. Default GL_LINEAR_MIPMAP_LINEAR."><br>
<font type {font_title} tint gray atint gray>
"Default GL_LINEAR_MIPMAP_LINEAR - World min."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_magfilter_mipped atext "_sofbuddy_magfilter_mipped : " noshade tip "World mag filter. GL_NEAREST or GL_LINEAR. Default GL_LINEAR."><br>
<font type {font_title} tint gray atint gray>
"Default GL_LINEAR - World mag filter."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_minfilter_ui atext "_sofbuddy_minfilter_ui : " noshade tip "UI min filter. Keep GL_NEAREST so fonts stay sharp. Default GL_NEAREST."><br>
<font type {font_title} tint gray atint gray>
"Default GL_NEAREST - UI min filter."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_magfilter_ui atext "_sofbuddy_magfilter_ui : " noshade tip "UI mag filter. Keep GL_NEAREST so fonts stay sharp. Default GL_NEAREST."><br>
<font type {font_title} tint gray atint gray>
"Default GL_NEAREST - UI mag filter."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_water_size atext "_sofbuddy_water_size : " noshade tip "Warp Texture chunk size (F12 Graphics): water, lava, sky turb. Smaller = finer, costlier. Min 16. Default 64."><br>
<font type {font_title} tint gray atint gray>
"Default 64 - Warp texture chunk size (water/lava/sky)."
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
"Lighting"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_preset atext "_sofbuddy_lighting_preset : " noshade tip "0 Vanilla, 1 2x Linear, 2 4x Linear, 3 Soft Glow, 5 Custom, 6 High Contrast, 7 Deep Shadows, 8 Film Slope, 9 Cliff Edge, 10 Bright Punch, 11 Midnight. Curve presets write the 11 slider values and use Preserve brightness. Raven 2x is now the independent Overbright Lighting toggle. Performance: selecting a preset rebuilds lightmaps once; no per-frame cost. F12 Lighting."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Stock SoF lighting."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_0 atext "_sofbuddy_lighting_curve_0 : " noshade tip "Curve output at 0% lightmap input. Output 0-100; 100 = white. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Input 0% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_10 atext "_sofbuddy_lighting_curve_10 : " noshade tip "Curve output at 10% lightmap input. Output 0-100; 100 = white. Default 10."><br>
<font type {font_title} tint gray atint gray>
"Default 10 - Input 10% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_20 atext "_sofbuddy_lighting_curve_20 : " noshade tip "Curve output at 20% lightmap input. Output 0-100; 100 = white. Default 20."><br>
<font type {font_title} tint gray atint gray>
"Default 20 - Input 20% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_30 atext "_sofbuddy_lighting_curve_30 : " noshade tip "Curve output at 30% lightmap input. Output 0-100; 100 = white. Default 30."><br>
<font type {font_title} tint gray atint gray>
"Default 30 - Input 30% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_40 atext "_sofbuddy_lighting_curve_40 : " noshade tip "Curve output at 40% lightmap input. Output 0-100; 100 = white. Default 40."><br>
<font type {font_title} tint gray atint gray>
"Default 40 - Input 40% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_50 atext "_sofbuddy_lighting_curve_50 : " noshade tip "Curve output at 50% lightmap input. Output 0-100; 100 = white. Default 50."><br>
<font type {font_title} tint gray atint gray>
"Default 50 - Input 50% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_60 atext "_sofbuddy_lighting_curve_60 : " noshade tip "Curve output at 60% lightmap input. Output 0-100; 100 = white. Default 60."><br>
<font type {font_title} tint gray atint gray>
"Default 60 - Input 60% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_70 atext "_sofbuddy_lighting_curve_70 : " noshade tip "Curve output at 70% lightmap input. Output 0-100; 100 = white. Default 70."><br>
<font type {font_title} tint gray atint gray>
"Default 70 - Input 70% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_80 atext "_sofbuddy_lighting_curve_80 : " noshade tip "Curve output at 80% lightmap input. Output 0-100; 100 = white. Default 80."><br>
<font type {font_title} tint gray atint gray>
"Default 80 - Input 80% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_90 atext "_sofbuddy_lighting_curve_90 : " noshade tip "Curve output at 90% lightmap input. Output 0-100; 100 = white. Default 90."><br>
<font type {font_title} tint gray atint gray>
"Default 90 - Input 90% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_curve_100 atext "_sofbuddy_lighting_curve_100 : " noshade tip "Curve output at 100% lightmap input. Output 0-100; 100 = white. Default 100."><br>
<font type {font_title} tint gray atint gray>
"Default 100 - Input 100% control point."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_preserve_color atext "_sofbuddy_lighting_preserve_color : " noshade tip "0 per-channel (classic overbright), 1 preserve brightness (luminance curve), 2 preserve colour (curve on brightest channel; no clipping; default). Built-in Lighting Style presets use 1."><br>
<font type {font_title} tint gray atint gray>
"Default 2 - Preserve colour."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_normalize atext "_sofbuddy_lighting_normalize : " noshade tip "Map lighting normalization. 0 off (default), 1 Up, 2 Down, 3 Both. Up moves the brightest sample toward 255 by the Up amount; Down moves the absolute minimum toward 0 by the Down amount while keeping the maximum, so values above the map max keep their headroom (no-op when the minimum is already 0); Both applies Down then Up. Amounts are map-relative percentages, so they adapt to the next map. Rebuilds the map's lightmaps when changed. Performance: one-time scan/rebuild; no per-frame cost."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Off. 1 Up, 2 Down, 3 Both."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_normalize_up atext "_sofbuddy_lighting_normalize_up : " noshade tip "Up amount percentage, default 100. 0 leaves the map maximum; 100 moves it to 255. Used by Up and Both. Target = max + amount x (255 - max), recalculated for each map."><br>
<font type {font_title} tint gray atint gray>
"Default 100 - Up amount %."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_normalize_down atext "_sofbuddy_lighting_normalize_down : " noshade tip "Down amount percentage, default 100. 0 leaves the map minimum; 100 moves it to 0. Used by Down and Both. Target = min - amount x min, recalculated for each map."><br>
<font type {font_title} tint gray atint gray>
"Default 100 - Down amount %."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_ghoul_min_light atext "_sofbuddy_lighting_ghoul_min_light : " noshade tip "Ghoul minimum-light floor. 0 Vanilla keeps the engine's 0.1 minimum for models with RF_MINLIGHT. 1 Bypass removes the floor so the model follows the lighting curve and can go fully dark. F12 Lighting -> Ghoul."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Vanilla. 1 Bypass."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_overbright atext "_sofbuddy_lighting_overbright : " noshade tip "Overbright Lighting. 1 = Raven's original 2 x L x T look with the separate Overbright Pre-Curve; 0 = use Lighting Style. Works with gl_ext_multitexture on or off. Default 0. Performance: small per-surface cost while On; Off does no combiner/blend work. F12 Lighting."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Legacy switch, kept for old configs."<br>
"Pre-curve: _sofbuddy_lighting_overbright_curve_0 ... _100 (default Popping mid+highlight 0,5,10,15,20,25,40,55,70,85,100)."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_overbright_profile atext "_sofbuddy_lighting_overbright_profile : " noshade tip "Overbright Pre-Curve profile, separate from Lighting Style. 0 Popping highlights, 1 Popping mid+highlight (default), 2 Preserve Darks only, 3 2x everything (linear identity / stock 2 x T x L), 4 Custom, 5 Late highlights. Selecting a profile writes its 11 values into the overbright curve cvars; editing a slider switches to Custom. F12 Lighting -> Overbright Pre-Curve."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Popping mid+highlight. 0 Popping highlights, 2 Preserve Darks only, 3 2x everything, 4 Custom, 5 Late highlights."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lighting_cutoff atext "_sofbuddy_lighting_cutoff : " noshade tip "D-Light Cut Off (F12 Lighting): min dynamic-light contribution / BSP culling margin (DLIGHT_CUTOFF). Default 64."><br>
<font type {font_title} tint gray atint gray>
"Default 64 - D-Light Cut Off."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lightblend_src atext "_sofbuddy_lightblend_src : " noshade tip "Custom blend source (F12 Lighting -> Custom). Default GL_ZERO."><br>
<font type {font_title} tint gray atint gray>
"Default GL_ZERO - Custom blend source."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_lightblend_dst atext "_sofbuddy_lightblend_dst : " noshade tip "Custom blend destination (F12 Lighting -> Custom). Default GL_SRC_COLOR."><br>
<font type {font_title} tint gray atint gray>
"Default GL_SRC_COLOR - Custom blend destination."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sofbuddy_shiny_spherical atext "_sofbuddy_shiny_spherical : " noshade tip "Shiny/Glossy surfaces (F12 Lighting): 0 Disabled, 1 Engine Decides, 2 As Planar (camera position only), 3 As Sphere Map (camera position + view angle), 4 Planar And SphereMap - double (experimental). Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Engine Decides (spherical where flagged or flat)."
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
"Input"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_rawmouse atext "_sofbuddy_rawmouse : " noshade tip "Raw mouse input bypassing accel. 1 on, 0 off. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Raw mouse input off."
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
"Singleplayer"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_forcerun_singleplayer atext "_sofbuddy_forcerun_singleplayer : " noshade tip "Force run speed in singleplayer. 1 on, 0 off. Default 0."><br>
<font type {font_title} tint gray atint gray>
"Default 0 - Stock walk/run key behavior."
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
"Multiplayer"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_local_mp_full_movescale atext "_sofbuddy_local_mp_full_movescale : " noshade tip "1: locally hosted multiplayer games use full movescale (1.0); 0: use the saved g_movescale (Half/Full server setting). Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Local servers run at full speed."
<hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint cyan atint cyan>
"Network / HTTP Maps"
<font type {font_title} tint white atint white>
<ctext _sofbuddy_http_maps atext "_sofbuddy_http_maps : " noshade tip "Map assist. 0 off, 1 primary, 2 random, 3 rotate. Default 1."><br>
<font type {font_title} tint gray atint gray>
"Default 1 - Use primary map provider."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
"_sofbuddy_http_maps_dl_1"
<hbr>
<font type {font_title} tint white atint white>
<input width 552 cvar _sofbuddy_http_maps_dl_1 border 8 1 gray maxchars 255 tip "Provider 1 zip download base URL. Default sofvault."><hbr>
<font type {font_title} tint gray atint gray>
"Default sofvault URL - Provider 1 download."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
"_sofbuddy_http_maps_dl_2"
<hbr>
<font type {font_title} tint white atint white>
<input width 552 cvar _sofbuddy_http_maps_dl_2 border 8 1 gray maxchars 255 tip "Provider 2 zip download base URL for random and rotate."><hbr>
<font type {font_title} tint gray atint gray>
"Default github mirror - Provider 2 download."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
"_sofbuddy_http_maps_dl_3"
<hbr>
<font type {font_title} tint white atint white>
<input width 552 cvar _sofbuddy_http_maps_dl_3 border 8 1 gray maxchars 255 tip "Provider 3 zip download base URL for random and rotate. Default empty."><hbr>
<font type {font_title} tint gray atint gray>
"Default empty - Provider 3 download."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
"_sofbuddy_http_maps_crc_1"
<hbr>
<font type {font_title} tint white atint white>
<input width 552 cvar _sofbuddy_http_maps_crc_1 border 8 1 gray maxchars 255 tip "Provider 1 CRC lookup base URL. Default sofvault."><hbr>
<font type {font_title} tint gray atint gray>
"Default sofvault URL - Provider 1 CRC."
<hbr>
<hbr>
<font type {font_title} tint white atint white>
"_sofbuddy_http_maps_crc_2"
<hbr>
<font type {font_title} tint white atint white>
<input width 552 cvar _sofbuddy_http_maps_crc_2 border 8 1 gray maxchars 255 tip "Provider 2 CRC lookup base URL paired with DL 2."><hbr>
<font type {font_title} tint gray atint gray>
"Default github mirror - Provider 2 CRC."
