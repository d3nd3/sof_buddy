<stm>
<include tints>

<backdrop bgcolor black>
<key n "killmenu">
<key y "killmenu;sofbuddy_update apply">
<key escape "killmenu">

<vbar tint orange>

<left>
<blank 16 1>
<right>
<blank 16 1>
<normal>

<center>
<font type {font_title} tint orange atint orange>
"INSTALL SELECTED RELEASE"
<hbr>
<hbr>

<font type {font_title} tint white atint white>
<ctext _sb_internal_update_local_label atext "Installed : " noshade><hbr>
<ctext _sb_internal_update_latest atext "Selected tag : " noshade><hbr>
<ctext _sb_internal_update_release_title atext "Release : " noshade><hbr>
<hbr>

<font type {font_title} tint green atint green>
"For troubleshooting, use F12 Install stable release instead of a random older tag."
<hbr>
<hbr>

<font type {font_title} tint cyan atint cyan>
"What's new"
<hbr>
<font type {font_small} tint normaltext atint normaltext>
<left>
{update_prompt_notes}
<hbr>
<hbr>

<center>
<font type {font_title} tint white atint white>
"This will replace your current SoF Buddy build with the selected release."
<hbr>
<hbr>

<font type {font_title} tint normaltext atint red>
<left>
<text "Cancel (N)" border 16 1 gray key mouse1 "killmenu">
<right>
<font type {font_title} tint normaltext atint green>
<text "Download + install (Y)" border 16 1 gray key mouse1 "killmenu;sofbuddy_update apply">
</stm>
