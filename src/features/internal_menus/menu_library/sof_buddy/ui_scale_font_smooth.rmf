<stm>
<ctext _sofbuddy_font_scale_pct atext "Font Scale % : " tint sb_accent atint sb_accent noshade tip "0% = 1x. 100% = the vertical max. Below 2x, values round to the nearest integer; when max is below 2x, Smooth stays at 1x."><br>
<slider cvari _sofbuddy_font_scale_pct min 0 max 100 step 1><br>
<font type {font_title} tint sb_accent atint sb_accent>
<ctext _sb_internal_font_scale_rounded atext "Current font scale : " noshade><br>
<font type {font_title} tint white atint white>
<text "Reset to default (75%)" key mouse1 "sofbuddy_scale_reset font" border 8 1 cyan regular align center><br>
</stm>
