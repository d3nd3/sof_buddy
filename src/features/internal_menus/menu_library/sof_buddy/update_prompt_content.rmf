<stm>
<include tints>

<backdrop bgcolor black>
<key n "killmenu">
<key y "killmenu;sofbuddy_update download;sofbuddy_update_install">
<key escape "killmenu">

<vbar tint orange>

<left>
<blank 16 1>
<right>
<blank 16 1>
<normal>

<center>
<font type title tint orange atint orange>
"SOF BUDDY UPDATE AVAILABLE"
<hbr>
<hbr>

<font type title tint white atint white>
<ctext _sb_internal_update_local_label atext "Installed : " noshade><hbr>
<ctext _sb_internal_update_latest atext "Available tag : " noshade><hbr>
<ctext _sb_internal_update_release_title atext "Release : " noshade><hbr>
<ctext _sb_internal_update_downloaded_asset atext "Download package : " noshade><hbr>
<hbr>

<font type title tint cyan atint cyan>
"What's new"
<hbr>
<font type title tint white atint white>
<left>
<includecvar _sb_internal_update_prompt_notes_rmf_00>
<includecvar _sb_internal_update_prompt_notes_rmf_01>
<includecvar _sb_internal_update_prompt_notes_rmf_02>
<includecvar _sb_internal_update_prompt_notes_rmf_03>
<includecvar _sb_internal_update_prompt_notes_rmf_04>
<includecvar _sb_internal_update_prompt_notes_rmf_05>
<includecvar _sb_internal_update_prompt_notes_rmf_06>
<includecvar _sb_internal_update_prompt_notes_rmf_07>
<includecvar _sb_internal_update_prompt_notes_rmf_08>
<includecvar _sb_internal_update_prompt_notes_rmf_09>
<hbr>
<hbr>

<center>
<font type title tint white atint white>
"Download the release zip and run the installer when you exit?"
<hbr>
<hbr>

<font type title tint normaltext atint red>
<left>
<text "Not now (N)" border 16 1 gray key mouse1 "killmenu">
<right>
<font type title tint normaltext atint green>
<text "Download + install (Y)" border 16 1 gray key mouse1 "killmenu;sofbuddy_update download;sofbuddy_update_install">
</stm>
