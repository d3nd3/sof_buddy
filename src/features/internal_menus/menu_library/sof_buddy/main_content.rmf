<stm>
<include tints>
{theme_tints}
<key escape "popmenu">
<cursor 1>

<vbar tint sb_accent>

<defaults noborder tiptint normaltext tipbtint sb_panel tipfont title>
<backdrop bgcolor sb_bg>

<left>
{content_inset_tall}
<right>
{content_inset_tall}
<normal>

<include sof_buddy/tabs/main>

<center>
<font type title tint sb_accent atint sb_accent>
"_____________________________"
<hbr>
<hbr>
<font type title tint white atint white>
<text "SOF BUDDY: VERSION" tip "Build and updater status">
<center>
<font type title tint cyan atint cyan>
"_____________________________"
<hbr>
<hbr>
<font type title tint white atint white>
<ctext _sb_internal_build_flavour atext "Flavour : " tint white atint white noshade><hbr>
<ctext _sb_internal_version atext "Version : " tint white atint white noshade><hbr>
<ctext _sb_internal_build_number atext "Build : " tint white atint white noshade><hbr>
<ctext _sb_internal_update_status atext "Updater : " tint white atint white noshade><hbr>
<ctext _sb_internal_update_latest atext "Checked tag : " tint white atint white noshade><hbr>
<ctext _sb_internal_update_stable_tag atext "Stable tag : " tint white atint white noshade tip "Blessed release from stable.json (see Install stable)."><hbr>
<hbr>
<list "Off,On" match "0,1" cvar _sofbuddy_update_use_gui atext "Graphical updater : " noshade tip "Use sof_buddy_update.exe when installing (universal builds). Default On on universal; Off uses script or in-game extract on Wine/Proton."><hbr>
<list "Off,On" match "0,1" cvar _sofbuddy_update_show_all_releases atext "Show non-stable tags : " noshade tip "Off keeps the version list to Stable, Latest, and the current stable tag. Refresh the list after changing."><hbr>
<list "Off,On" match "0,1" cvar _sofbuddy_update_startup_stable_only atext "Startup notify stable only : " noshade tip "Limits the startup update popup to stable releases, not Latest CI."><hbr>
<includecvar _sb_internal_update_release_list_rmf>
<ctext _sb_internal_update_release_list_status atext "Release list : " noshade tip "Run Refresh release list after changing the update API URL or tag filter."><hbr>
<text "Refresh release list" key mouse1 "sofbuddy_update releases" border 8 1 cyan regular align center tip "Fetch installable tags from the update feed and reload this page."><hbr>
<hbr>
<text "Install stable release (recommended)" key mouse1 "sofbuddy_update stable" border 12 1 gray regular align center tip "Target the stable channel and open the install dialog (upgrade or downgrade)."><hbr>
<hbr>
<text "Install selected version" key mouse1 "sofbuddy_update apply" border 8 1 cyan regular align center tip "Download and install the version chosen above (including downgrades)."><hbr>
<hbr>
<text "Check for updates" key mouse1 "sofbuddy_update prompt" border 8 1 cyan regular align center tip "Re-check the feed and open the update or up-to-date dialog."><hbr>

<font type title tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<text "Close" key mouse1 "popmenu" border 8 1 cyan regular align center><hbr>
<hbr>
<normal>
<font type title tint gray atint gray>
Use tabs above to switch sections without leaving this menu.
<hbr><hbr>
Renderer-side changes may require vid_restart to fully apply.
</stm>
