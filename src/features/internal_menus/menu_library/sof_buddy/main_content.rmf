<stm>
<include tints>
{theme_tints}
<key escape "popmenu">
<cursor 1>

<vbar tint sb_accent>

<defaults noborder tiptint normaltext tipbtint sb_panel tipfont {tipfont}>
<backdrop bgcolor sb_bg>

<left>
{content_inset_tall}
<right>
{content_inset_tall}
<normal>


<center>
<font type {font_title} tint sb_accent atint sb_accent>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<text "SOF BUDDY: VERSION" tip "Build and updater status">
<center>
<font type {font_title} tint cyan atint cyan>
"_____________________________"
<hbr>
<hbr>
<font type {font_title} tint white atint white>
<ctext _sb_internal_build_flavour atext "Flavour : " tint white atint white noshade><hbr>
<ctext _sb_internal_version atext "Version : " tint white atint white noshade><hbr>
<ctext _sb_internal_build_number atext "Build : " tint white atint white noshade><hbr>
<ctext _sb_internal_update_status atext "Updater : " tint white atint white noshade><hbr>
<ctext _sb_internal_update_latest atext "Checked tag : " tint white atint white noshade><hbr>
<ctext _sb_internal_update_stable_tag atext "Stable tag : " tint white atint white noshade tip "Latest non-prerelease release from master."><hbr>
<ctext _sb_internal_update_unstable_tag atext "Unstable tag : " tint white atint white noshade tip "Latest prerelease build from the unstable branch."><hbr>
<hbr>
<list "Off,On" match "0,1" cvar _sofbuddy_update_use_gui atext "Graphical updater : " noshade tip "Use sof_buddy_update.exe when installing (universal builds). Default On on universal; Off uses script or in-game extract on Wine/Proton."><hbr>
<list "Off,On" match "0,1" cvar _sofbuddy_update_show_all_releases atext "Show older releases : " noshade tip "Off shows channels plus the latest stable/unstable tags and the selected tag. On shows up to 12 recent release tags. Refresh the list after changing."><hbr>
<list "Off,On" match "0,1" cvar _sofbuddy_update_startup_stable_only atext "Startup notify stable only : " noshade tip "Limits the startup update popup to stable releases from master."><hbr>
<ctext _sofbuddy_update_target_tag atext "Selected install target : " tint green atint green noshade tip "Click a release in the list below to change the install target."><hbr>
<hbr>
<text "Install stable release (recommended)" key mouse1 "sofbuddy_update stable" border 12 1 gray regular align center tip "Target the stable channel and open the install dialog (upgrade or downgrade)."><hbr>
<hbr>
<text "Install unstable build (testing)" key mouse1 "sofbuddy_update unstable" border 8 1 orange regular align center tip "Target the unstable prerelease channel and open the install dialog."><hbr>
<hbr>
<text "Install selected version" key mouse1 "sofbuddy_update apply" border 8 1 cyan regular align center tip "Download and install the version chosen in the list (including downgrades)."><hbr>
<hbr>
<text "Check for updates" key mouse1 "sofbuddy_update prompt" border 8 1 cyan regular align center tip "Re-check the feed and open the update or up-to-date dialog."><hbr>

<font type {font_title} tint sb_subtle atint sb_subtle>
"_____________________________"
<hbr>
<hbr>
<text "Close" key mouse1 "popmenu" border 8 1 cyan regular align center><hbr>
<hbr>
</stm>
