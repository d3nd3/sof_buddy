<stm nopush global>
<include tints>
{theme_tints}
<key escape "sofbuddy_menu sof_buddy">
<cursor 1>

<defaults noborder tiptint black tipbtint white tipfont {tipfont}>

<cinclude _sb_internal_tabs_wide sof_buddy/nav_frame_profiles_wide>
<cninclude _sb_internal_tabs_wide sof_buddy/nav_frame_profiles_narrow>
<frame center_panel 640 0 page sof_buddy/cpu_content border 0 0 clear backfill clear>
</stm>
