<stm>
<include tints>
<backdrop bgcolor black>

<left>
<blank 16 1>
<right>
<blank 16 1>
<normal>

<center>
<font type title tint white atint white>
"Download the release zip and run the installer when you exit?"
<hbr>
<hbr>

<font type title tint normaltext atint red>
<left>
<text "Not now (N)" border 16 1 gray key mouse1 "killmenu">
<right>
